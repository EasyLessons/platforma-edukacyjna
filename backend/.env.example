# Skopiuj ten plik do backend/.env i uzupełnij prawdziwymi wartościami:
#   cp backend/.env.example backend/.env
#
# backend/.env jest w .gitignore — nigdy nie commitujemy prawdziwych sekretów.

# JWT — jak długo żyje access token (w minutach) i jakim algorytmem jest podpisany
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
# Losowy, długi ciąg znaków używany do podpisywania JWT — WYGENERUJ WŁASNY,
# nigdy nie używaj tego samego SECRET_KEY co ktoś inny/produkcja.
# Można wygenerować np. przez: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Baza danych — connection string do Postgresa (Neon, serverless — patrz README)
DATABASE_URL=

# Resend — wysyłka maili (kody weryfikacyjne, reset hasła)
RESEND_API_KEY=
FROM_EMAIL=

# Adres frontendu — używany do generowania linków w mailach (np. link do resetu hasła)
FRONTEND_URL=http://localhost:3000

# Google OAuth (Google Cloud Console) — ten sam projekt co NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Port, na którym startuje uvicorn (lokalnie/w Dockerze zwykle 8000)
PORT=8000

# Supabase — service role key (PEŁEN dostęp, omija RLS!) do wysyłania Broadcast
# z backendu. Nigdy nie używaj tego klucza po stronie frontendu.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Klucz serwis-serwis dla whiteboard-sync (GET/POST /api/v1/whiteboard/{id}/doc, naglowek
# X-Sync-Service-Token). TA SAMA wartosc musi byc w env whiteboard-sync. Pusty = wylaczony
# (whiteboard-sync zapisuje wtedy tokenem usera, ktory wygasa po 15 min polaczenia).
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_SERVICE_TOKEN=

# Daily — rozmowa glosowa na tablicy (POST /api/v1/whiteboard/{id}/call). Klucz API z panelu
# Daily (Developers -> API keys); TYLKO backend, nigdy frontend. Pusty = rozmowy wylaczone
# (endpoint zwraca 503 VOICE_NOT_CONFIGURED, reszta tablicy dziala normalnie).
# KROK 1, ZANIM wpiszesz klucz: ustaw CALL_ALLOWED_USER_IDS (nizej) na swoje id uzytkownika -
# przy pustej liscie pokoje moze tworzyc KAZDY wlasciciel przestrzeni.
DAILY_API_KEY=
# Prefiks nazw pokoi (<prefiks>-board-<id>). Ustaw inny niz na produkcji, jesli dev korzysta
# z tego samego konta Daily. Domyslnie: easylesson.
# DAILY_ROOM_PREFIX=easylesson
# Na ile minut wlasciciel tworzy pokoj; po tym czasie Daily rozlacza uczestnikow (wlasciciel moze
# przedluzyc, klikajac "Rozmowa" w ostatnich 15 min). Domyslnie 90, twardy sufit w kodzie 180 (3 h),
# minimum 10. Pusta / nieliczbowa wartosc = domyslna. Caly czas pokoju x CALL_MAX_PARTICIPANTS jest
# z gory rezerwowany w progu miesiecznym.
# DAILY_ROOM_TTL_MINUTES=90
#
# --- Bezpieczniki kosztow rozmow (docs/architecture/pipelines.md pkt 5a) ---
# Zadna z ponizszych wartosci (pusta, smieciowa) nie wywraca startu backendu.
# Wylacznik awaryjny. false = endpoint zwraca 503 VOICE_DISABLED, nic nie trafia do Daily.
# Domyslnie true; wartosc nierozpoznana = wylaczone.
# CALL_ENABLED=true
# Kto moze TWORZYC pokoje: id uzytkownikow po przecinku (np. 1,7). Pusta = kazdy wlasciciel
# przestrzeni (backend loguje wtedy WARNING); niepusty segment nie do sparsowania = nikt.
# Pozostali czlonkowie tylko dolaczaja. NA PRODUKCJI USTAW na swoje id przed wpisaniem klucza.
# CALL_ALLOWED_USER_IDS=
# Kto widzi GET /api/v1/whiteboard/call/usage (zuzycie minut, stan). Id po przecinku. Pusta = nikt.
# CALL_ADMIN_USER_IDS=
# Globalny prog minut uczestnikow w miesiacu (UTC): zuzycie wg Daily (/meetings) + rezerwacja
# pelnego czasu zycia kazdego pokoju (do 30 min po jego koncu). Powyzej: 429 VOICE_MONTHLY_LIMIT.
# Domyslnie 8000 (darmowa pula Daily to 10 000), twardy sufit w kodzie 9500; 0 = brak tokenow.
# DAILY_MONTHLY_MINUTES_CAP=8000
# Ile minut rozmow dziennie (UTC) ma jeden wlasciciel: zywy pokoj liczy sie caly, zakonczony -
# wg realnego czasu rozmowy. Domyslnie 240 (np. 4 lekcje po 60 min), sufit 1440.
# CALL_USER_DAILY_MINUTES_CAP=240
# Limit osob w pokoju. Domyslnie 4, zakres 2-20.
# CALL_MAX_PARTICIPANTS=4

# CORS — jawna lista originow frontendu (przecinki, bez wildcardow). Zakomentowane = wartosc
# domyslna z core/config.py: produkcja (easylesson.app, www) + localhost:3000/8000.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Opcjonalny regex originow (fullmatch), np. dla preview Vercela. Domyslnie pusty = wylaczony;
# NIGDY nie wpisuj tu ogolnego *.vercel.app — patrz docs/architecture/auth.md.
# ALLOWED_ORIGIN_REGEX=

# Proxy — od kogo ufamy X-Forwarded-For/Proto (jak --forwarded-allow-ips uvicorna). Puste =
# automatycznie: "*" na Render (env RENDER), lokalnie "127.0.0.1".
# FORWARDED_ALLOW_IPS=
# Naglowek z IP klienta NADPISYWANY przez brzeg sieci — rate limit bierze IP z niego w pierwszej
# kolejnosci. Puste = automatycznie: CF-Connecting-IP na Render, lokalnie wylaczone; "none" = wylaczone.
# CLIENT_IP_HEADER=
# Gdy naglowka powyzej nie ma: ktory wpis X-Forwarded-For LICZAC OD PRAWEJ jest adresem klienta
# (1 = ostatni). Lewych wpisow nie uzywamy — wysyla je klient.
# TRUSTED_PROXY_HOPS=1
