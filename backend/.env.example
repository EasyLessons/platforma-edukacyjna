# Skopiuj ten plik do backend/.env i uzupełnij prawdziwymi wartościami:
#   cp backend/.env.example backend/.env
#
# backend/.env jest w .gitignore — nigdy nie commitujemy prawdziwych sekretów.

# JWT — jak długo żyje access token (w minutach) i jakim algorytmem jest podpisany
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
# Losowy, długi ciąg znaków używany do podpisywania JWT — WYGENERUJ WŁASNY,
# nigdy nie używaj tego samego SECRET_KEY co ktoś inny/produkcja.
# Można wygenerować np. przez: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Baza danych — connection string do Postgresa (Neon, serverless — patrz README)
DATABASE_URL=

# Resend — wysyłka maili (kody weryfikacyjne, reset hasła)
RESEND_API_KEY=
FROM_EMAIL=

# Adres frontendu — używany do generowania linków w mailach (np. link do resetu hasła)
FRONTEND_URL=http://localhost:3000

# Google OAuth (Google Cloud Console) — ten sam projekt co NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Port, na którym startuje uvicorn (lokalnie/w Dockerze zwykle 8000)
PORT=8000

# Supabase — service role key (PEŁEN dostęp, omija RLS!) do wysyłania Broadcast
# z backendu. Nigdy nie używaj tego klucza po stronie frontendu.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
