# Zmienne whiteboard-sync (serwer Hocuspocus). Na Renderze ustawiane w panelu serwisu;
# lokalnie: export albo docker-compose.yml. Nigdy nie commitujemy prawdziwych wartosci.

# Port WebSocket (Render ustawia go sam)
PORT=1234

# Adres backendu FastAPI widziany z serwisu
BACKEND_URL=http://localhost:8000

# Klucz serwis-serwis do odczytu/zapisu snapshotu tablicy (GET/POST /whiteboard/{id}/doc).
# TA SAMA wartosc co SYNC_SERVICE_TOKEN w env backendu. Pusty = zapis tokenem usera
# (wygasa po 15 min trwajacego polaczenia - zmiany po tym czasie nie zapisywaly sie).
SYNC_SERVICE_TOKEN=
