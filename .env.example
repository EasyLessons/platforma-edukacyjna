# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami:
#   cp .env.example .env.local
#
# .env.local jest w .gitignore — nigdy nie commitujemy prawdziwych sekretów.

# Gemini API — klucz do AI Assistant (Google AI Studio)
GEMINI_API_KEY=

# Google OAuth — Client ID (z Google Cloud Console, ten sam projekt co backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Rozmowa przy tablicy: puste albo "daily" = Daily Prebuilt (features/voice-call; klucz
# DAILY_API_KEY jest TYLKO w backendzie), "legacy" = stary czat WebRTC + Xirsys
# (features/voice-chat) - wyjście awaryjne. Zmienna NEXT_PUBLIC_* jest wklejana w buildzie,
# więc zmiana wymaga przebudowania (Vercel: redeploy).
NEXT_PUBLIC_VOICE_PROVIDER=

# Xirsys — dostawca TURN/STUN do połączeń głosowych (WebRTC), używany tylko przy
# NEXT_PUBLIC_VOICE_PROVIDER=legacy.
# Zmienne SERWEROWE (bez NEXT_PUBLIC_!) — czyta je tylko Route Handler /api/turn,
# sekret nie może trafić do bundla przeglądarki (audyt SEC-05).
# Puste = voice działa na samych publicznych STUN/TURN (gorzej przez restrykcyjny NAT).
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=
# Opcjonalnie: regionalny host API Xirsys (np. europejski z panelu Xirsys) zamiast
# global.xirsys.net — region TURN jest dobierany wg położenia serwera, nie ucznia.
# XIRSYS_API_HOST=

# Supabase — używane WYŁĄCZNIE do Realtime (Broadcast + Presence), nie do auth.
# Klucz "anon" jest publiczny/bezpieczny dla frontendu (nie service role key!).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adres backendu FastAPI (widziany z przeglądarki)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Adres backendu widziany z SERWERA Next.js (opcjonalny).
# Używają go /api/chat i /api/turn do sprawdzenia tokenu przez GET /api/v1/auth/me.
# Pusty = fallback na NEXT_PUBLIC_API_URL. Potrzebny tylko wtedy, gdy serwer Next
# nie widzi backendu pod adresem publicznym — np. w docker-compose (http://backend:8000).
BACKEND_INTERNAL_URL=
