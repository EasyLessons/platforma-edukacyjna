# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami:
#   cp .env.example .env.local
#
# .env.local jest w .gitignore — nigdy nie commitujemy prawdziwych sekretów.

# Gemini API — klucz do AI Assistant (Google AI Studio)
GEMINI_API_KEY=

# Google OAuth — Client ID (z Google Cloud Console, ten sam projekt co backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase — używane WYŁĄCZNIE do Realtime (Broadcast + Presence), nie do auth.
# Klucz "anon" jest publiczny/bezpieczny dla frontendu (nie service role key!).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adres backendu FastAPI (widziany z przeglądarki)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Adres backendu widziany z SERWERA Next.js (opcjonalny).
# Używa go /api/chat do sprawdzenia tokenu przez GET /api/v1/auth/me.
# Pusty = fallback na NEXT_PUBLIC_API_URL. Potrzebny tylko wtedy, gdy serwer Next
# nie widzi backendu pod adresem publicznym — np. w docker-compose (http://backend:8000).
BACKEND_INTERNAL_URL=

# Formularz kontaktowy (/api/contact, Route Handler): skrzynka odbiorcza. Zmienna SERWEROWA.
# Pusta = kontakt@easylesson.app (ten sam adres co w stopce i na stronach prawnych).
# CONTACT_TO_EMAIL=

# Formularz kontaktowy wysyła maila przez REST Resend (https://api.resend.com/emails) z Route
# Handlera /api/contact. Zmienna SERWEROWA (bez NEXT_PUBLIC_!). Pusta = Resend odrzuca wysyłkę
# (kod nie sprawdza klucza osobno). Osobny wpis od backendowego RESEND_API_KEY w backend/.env.
RESEND_API_KEY=

# Silnik tablicy: "excalidraw" = Excalidraw (features/board-engine, tablica demo zawsze na nim),
# każda inna wartość albo puste = stary silnik (features/whiteboard, do usunięcia w etapie F).
# Wklejana w buildzie - zmiana wymaga przebudowania (Vercel: redeploy). Opis: docs/architecture/stack.md.
NEXT_PUBLIC_WHITEBOARD_ENGINE=

# Adres serwisu whiteboard-sync (Hocuspocus, WebSocket) widziany z przeglądarki.
# Lokalnie ws://localhost:1234 (domyślna wartość w kodzie, gdy zmienna jest pusta), na produkcji
# wss://<host-whiteboard-sync>. Używany przez oba silniki (features/whiteboard/yjs/sync-url.ts).
NEXT_PUBLIC_WHITEBOARD_SYNC_URL=

# Opcjonalny link w modalu "Premium" (features/plans/components/upgrade-modal.tsx), np. formularz
# zainteresowania. Puste = modal pokazuje tylko adres kontakt@easylesson.app.
# NEXT_PUBLIC_PREMIUM_INTEREST_URL=

# Logi debug/info z createLogger (src/_new/lib/logger.ts) także poza developmentem.
# "1" = włączone; puste = w production/test wychodzą tylko warn/error.
# NEXT_PUBLIC_DEBUG_LOGS=

# TYLKO testy E2E (playwright.config.ts ustawia "1"): wystawia window.__boardEngine do odczytu
# stanu tablicy przez Playwright (features/board-engine/components/excalidraw-board.tsx).
# Nie ustawiaj w .env.local ani na produkcji.
# NEXT_PUBLIC_E2E=
