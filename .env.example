# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami:
#   cp .env.example .env.local
#
# .env.local jest w .gitignore — nigdy nie commitujemy prawdziwych sekretów.

# Gemini API — klucz do AI Assistant (Google AI Studio)
GEMINI_API_KEY=

# Google OAuth — Client ID (z Google Cloud Console, ten sam projekt co backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Xirsys — dostawca TURN/STUN do połączeń głosowych (WebRTC)
NEXT_PUBLIC_XIRSYS_IDENT=
NEXT_PUBLIC_XIRSYS_SECRET=
NEXT_PUBLIC_XIRSYS_CHANNEL=

# Supabase — używane WYŁĄCZNIE do Realtime (Broadcast + Presence), nie do auth.
# Klucz "anon" jest publiczny/bezpieczny dla frontendu (nie service role key!).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adres backendu FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
